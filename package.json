{
  "name": "ice-game",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "大漠穷秋 <damoqiongqiu@126.com>",
  "description": "ICE 游戏厅：把 ICE 家族画布控件拼成能玩的游戏。掌机四卡带（俄罗斯方块 / 贪吃蛇 / 2048 / CHIP-8）+ 一台会开机的 Windows XP 桌面（含扫雷）。画面里没有一个位图资源。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ice-render/ice-game.git"
  },
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "serve": "http-server dist -p 8097 -c-1",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "types:check": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "node scripts/shoot-screenshots.mjs",
    "verify": "npm run types:check && npm test && npm run build"
  },
  "dependencies": {
    "ice-render": "file:../ice-render",
    "ice-web-components": "file:../ice-web-components"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.130",
    "html-webpack-plugin": "^5.6.0",
    "http-server": "^14.1.1",
    "jest": "29.7.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "5.9.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}
